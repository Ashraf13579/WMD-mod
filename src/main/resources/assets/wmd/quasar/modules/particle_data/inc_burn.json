{
  "render_style": "veil:cube",
  "additive": true,
  "should_collide": false,
  "face_velocity": false,
  "modules": [
    {
      "module": "initial_velocity",
      "direction": [
        0.0,
        1.0,
        0.0
      ],
      "strength": 0.08
    },
    {
      "module": "drag",
      "strength": 0.9
    },
    {
      "module": "size",
      "size": "0.35 * (1.0 + q.agePercent) * (1.0 - q.agePercent)"
    },
    {
      "module": "color",
      "gradient": {
        "rgb_points": [
          {
            "percent": 0.0,
            "color": [
              255,
              240,
              180
            ]
          },
          {
            "percent": 0.3,
            "color": [
              255,
              170,
              60
            ]
          },
          {
            "percent": 0.75,
            "color": [
              220,
              70,
              20
            ]
          },
          {
            "percent": 1.0,
            "color": [
              60,
              40,
              30
            ]
          }
        ],
        "alpha_points": [
          {
            "percent": 0.0,
            "alpha": 1.0
          },
          {
            "percent": 0.7,
            "alpha": 0.85
          },
          {
            "percent": 1.0,
            "alpha": 0.0
          }
        ]
      },
      "interpolant": "q.agePercent"
    }
  ]
}
