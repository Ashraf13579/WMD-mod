{
  "render_style": "veil:cube",
  "additive": false,
  "should_collide": false,
  "face_velocity": false,
  "modules": [
    {
      "module": "drag",
      "strength": 0.97
    },
    {
      "module": "size",
      "size": "1.600 * (1.0 + q.agePercent * 2.0)"
    },
    {
      "module": "color",
      "gradient": {
        "rgb_points": [
          {
            "percent": 0.0,
            "color": [
              235,
              235,
              235
            ]
          },
          {
            "percent": 1.0,
            "color": [
              200,
              200,
              205
            ]
          }
        ],
        "alpha_points": [
          {
            "percent": 0.0,
            "alpha": 0.0
          },
          {
            "percent": 0.1,
            "alpha": 0.85
          },
          {
            "percent": 0.75,
            "alpha": 0.7
          },
          {
            "percent": 1.0,
            "alpha": 0.0
          }
        ]
      },
      "interpolant": "q.agePercent"
    }
  ]
}
